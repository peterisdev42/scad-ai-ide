[
  {
    "type": "function",
    "function": {
      "name": "scad_ai_ide_model_checkAssembly",
      "description": "Freeze every declared part and validate all required raw-solid prerequisites and Manifest constraints in one snapshot. URI executes; reportId only reads existing evidence. expectedManifestDigest locks the repair baseline; pairIds can add geometric pair queries but cannot replace or override required checks. Distances are conservative intervals on frozen exported meshes. No overlap-volume, repair, motion or printability check. Requires Workspace Trust.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reportId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "pairIds": {
            "type": "array",
            "maxItems": 512,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "expectedManifestDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedSnapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "quality": {
            "enum": [
              "verification"
            ]
          },
          "tessellation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fn": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "fa": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 360
              },
              "fs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "scad_ai_ide_model_getIssue",
      "description": "Read one issue from a specific analysis report. Optional bounded local CLI evidence; includes runtime, snapshot ID and whether the report is still current. Expired reports are not recomputed implicitly. Historical results are evidence only; analyze the current document before claiming a repair. No source writes or CLI execution. Geometry v2 includes bounded triangle/component/spatial evidence and pagination. Binary mesh issues have model-level positions, never invented source lines.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reportId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "issueId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "includeEvidence": {
            "type": "boolean",
            "default": false
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "reportId",
          "issueId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "scad_ai_ide_model_listParts",
      "description": "Read optional .scad/verification.json declarations or an existing v3 report without compiling. Returns stable author IDs scoped to canonical Manifest URI, manifestDigest for repair baseline, and paginated parts/checks. Relative entries resolve from project root (parent of .scad). Missing Manifest returns UNRESOLVED NO_STABLE_PARTS. Requires Workspace Trust.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reportId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "section": {
            "enum": [
              "parts",
              "checks"
            ],
            "default": "parts"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "includeHints": {
            "type": "boolean"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "scad_ai_ide_model_measure",
      "description": "Read basic mesh measurements by existing reportId, or explicitly verify a workspace uri first. Report IDs never recompile missing/expired evidence. Includes snapshot/current status, units, scope and unresolved items. Physical volume is returned only when raw topology, self-intersection, shell composition and winding permit it. Based on exported mesh; no analytic surface, assembly or printability proof. Standalone STL/3MF requires no runtime. Workspace Trust required. For assembly v3 reportId, partIds selects declared frozen parts; no implicit assembly compilation. Assembly total volume is not computed.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reportId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "projectRoot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "expectedSnapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "quality": {
            "type": "string",
            "enum": [
              "verification"
            ]
          },
          "units": {
            "type": "string",
            "enum": [
              "mm"
            ]
          },
          "requireNonEmpty": {
            "type": "boolean"
          },
          "tessellation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fn": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "fa": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 360
              },
              "fs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "measurementTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "bounds",
                "surfaceArea",
                "signedVolume",
                "physicalVolume",
                "topology"
              ]
            }
          },
          "objectOffset": {
            "type": "integer",
            "minimum": 0
          },
          "objectLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 20
          },
          "partIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "scad_ai_ide_model_renderViews",
      "description": "Render the same frozen mesh artifact using official CLI PNG. Supply uri to verify first, or reportId to use existing evidence only. Default iso/front/top 512x512, at most four views. Metadata/artifact delivery by default. Explicit inline uses native image parts within 4 MiB, otherwise metadata fallback. Camera, source/rendered hashes, runtime and display quantization accompany images. Images are display evidence, not visual PASS. Missing runtime/render environment leaves geometry evidence valid. Requires Workspace Trust; no source writes. For assembly v3 reportId, partIds selects declared frozen parts; no implicit assembly compilation. Assembly total volume is not computed.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reportId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "projectRoot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "expectedSnapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "quality": {
            "type": "string",
            "enum": [
              "verification"
            ]
          },
          "units": {
            "type": "string",
            "enum": [
              "mm"
            ]
          },
          "requireNonEmpty": {
            "type": "boolean"
          },
          "tessellation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fn": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "fa": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 360
              },
              "fs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "cameras": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "iso",
                    "front",
                    "top",
                    "right"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "eye",
                    "target"
                  ],
                  "properties": {
                    "eye": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    },
                    "target": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    },
                    "projection": {
                      "type": "string",
                      "enum": [
                        "orthographic",
                        "perspective"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "imageSize": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            }
          },
          "delivery": {
            "type": "string",
            "enum": [
              "metadata",
              "inline"
            ],
            "default": "metadata"
          },
          "partIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      }
    }
  }
]