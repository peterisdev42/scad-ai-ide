{
    "name": "OpenSCAD",
    "scopeName": "source.openscad",
    "patterns": [
        {
            "include": "#expressions"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.openscad",
                    "begin": "//",
                    "end": "$"
                },
                {
                    "name": "comment.block.openscad",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.openscad",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.openscad",
                    "match": "\\\\."
                }
            ]
        },
        "imports": {
            "begin": "\\b(include|use)\\b",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.import.openscad"
                }
            },
            "end": "(?<=>)|(?=;|$)",
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "name": "string.unquoted.path.openscad",
                    "begin": "<",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.openscad"
                        }
                    },
                    "end": ">",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.openscad"
                        }
                    }
                }
            ]
        },
        "declarations": {
            "name": "meta.function.declaration.openscad",
            "begin": "\\b(module|function)\\s+([A-Za-z_][A-Za-z_0-9]*)",
            "beginCaptures": {
                "1": {
                    "name": "storage.type.function.openscad"
                },
                "2": {
                    "name": "entity.name.function.openscad"
                }
            },
            "end": "(?=[{=;])|(?=^\\s*(?:module|function)\\b)",
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#parameters"
                }
            ]
        },
        "parameters": {
            "name": "meta.function.parameters.openscad",
            "begin": "\\(",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.parameters.begin.openscad"
                }
            },
            "end": "\\)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.parameters.end.openscad"
                }
            },
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "name": "meta.parameter.default.openscad",
                    "begin": "(\\$?[A-Za-z_][A-Za-z_0-9]*)\\s*(=)(?!=)",
                    "beginCaptures": {
                        "1": {
                            "name": "variable.parameter.openscad"
                        },
                        "2": {
                            "name": "keyword.operator.assignment.openscad"
                        }
                    },
                    "end": "(?=,|\\))",
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                },
                {
                    "name": "variable.parameter.openscad",
                    "match": "(?<![\\w$])\\$?[A-Za-z_][A-Za-z_0-9]*"
                },
                {
                    "include": "#expressions"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "storage.type.function.openscad",
                    "match": "\\b(module|function)\\b"
                },
                {
                    "name": "keyword.control.openscad",
                    "match": "\\b(if|else|for|intersection_for|let|assign|each)\\b"
                },
                {
                    "name": "constant.language.openscad",
                    "match": "\\b(true|false|undef)\\b"
                }
            ]
        },
        "calls": {
            "name": "meta.function-call.openscad",
            "begin": "(?<![\\w$])([A-Za-z_][A-Za-z_0-9]*)\\s*(\\()",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.function.call.openscad"
                },
                "2": {
                    "name": "punctuation.section.arguments.begin.openscad"
                }
            },
            "end": "\\)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.arguments.end.openscad"
                }
            },
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "match": "(?<![\\w$])(\\$?[A-Za-z_][A-Za-z_0-9]*)\\s*(=)(?!=)",
                    "captures": {
                        "1": {
                            "name": "variable.parameter.named.openscad"
                        },
                        "2": {
                            "name": "keyword.operator.assignment.openscad"
                        }
                    }
                },
                {
                    "include": "#expressions"
                }
            ]
        },
        "special-variables": {
            "name": "variable.language.special.openscad",
            "match": "\\$[A-Za-z_][A-Za-z_0-9]*"
        },
        "variables": {
            "name": "variable.other.readwrite.openscad",
            "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b"
        },
        "numbers": {
            "name": "constant.numeric.openscad",
            "match": "(?<![\\w$])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?!\\w)"
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.openscad",
                    "match": "==|!=|<=|>=|[<>]"
                },
                {
                    "name": "keyword.operator.logical.openscad",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.assignment.openscad",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.openscad",
                    "match": "[+*/%\\^~-]"
                },
                {
                    "name": "keyword.operator.ternary.openscad",
                    "match": "[?:]"
                },
                {
                    "name": "keyword.operator.modifier.openscad",
                    "match": "#"
                }
            ]
        },
        "parentheses": {
            "name": "meta.group.openscad",
            "begin": "\\(",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.parens.begin.openscad"
                }
            },
            "end": "\\)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.parens.end.openscad"
                }
            },
            "patterns": [
                {
                    "include": "#expressions"
                }
            ]
        },
        "vectors": {
            "name": "meta.sequence.openscad",
            "begin": "\\[",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.brackets.begin.openscad"
                }
            },
            "end": "\\]",
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.brackets.end.openscad"
                }
            },
            "patterns": [
                {
                    "include": "#expressions"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.section.block.openscad",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.separator.openscad",
                    "match": ","
                },
                {
                    "name": "punctuation.terminator.statement.openscad",
                    "match": ";"
                }
            ]
        },
        "expressions": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#imports"
                },
                {
                    "include": "#anonymous-functions"
                },
                {
                    "include": "#declarations"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#calls"
                },
                {
                    "include": "#special-variables"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#variables"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#parentheses"
                },
                {
                    "include": "#vectors"
                },
                {
                    "include": "#punctuation"
                }
            ]
        },
        "anonymous-functions": {
            "name": "meta.function.expression.openscad",
            "begin": "\\b(function)\\s*(?=\\()",
            "beginCaptures": {
                "1": {
                    "name": "storage.type.function.openscad"
                }
            },
            "end": "(?<=\\))",
            "patterns": [
                {
                    "include": "#parameters"
                }
            ]
        }
    }
}
