{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}",
            "notIn": ["string", "comment"]
        },
        {
            "open": "[",
            "close": "]",
            "notIn": ["string", "comment"]
        },
        {
            "open": "(",
            "close": ")",
            "notIn": ["string", "comment"]
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": ["string", "comment"]
        }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "autoCloseBefore": ";:.,=}]) \n\t",
    "wordPattern": "\\$?[a-zA-Z_][a-zA-Z_0-9]*",
    "indentationRules": {
        "increaseIndentPattern": "^(?:\"(?:\\\\.|[^\"\\\\])*\"|/\\*.*?\\*/|/(?![/*])|[^\"/])*(?:\\{(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|/\\*.*?\\*/|/(?![/*])|[^\"/{}])|\\{(?:\"(?:\\\\.|[^\"\\\\])*\"|/\\*.*?\\*/|/(?![/*])|[^\"/{}])*\\})*|\\((?:(?:\"(?:\\\\.|[^\"\\\\])*\"|/\\*.*?\\*/|/(?![/*])|[^\"/()])|\\((?:\"(?:\\\\.|[^\"\\\\])*\"|/\\*.*?\\*/|/(?![/*])|[^\"/()])*\\))*|\\[(?:(?:\"(?:\\\\.|[^\"\\\\])*\"|/\\*.*?\\*/|/(?![/*])|[^\"/\\[\\]])|\\[(?:\"(?:\\\\.|[^\"\\\\])*\"|/\\*.*?\\*/|/(?![/*])|[^\"/\\[\\]])*\\])*)(?:\\s*//.*)?$",
        "decreaseIndentPattern": "^\\s*[\\}\\)\\]]",
        "unIndentedLinePattern": "^\\s*//.*$",
        "indentNextLinePattern": "^\\s*(?:(?:else\\s+)?(?:[!#%*]*\\s*[A-Za-z_$][\\w$]*\\s*\\((?:\"(?:\\\\.|[^\"\\\\])*\"|[^\"{};])*\\)\\s*)|else\\s*)(?://.*)?$"
    },
    "folding": {
        "markers": {
            "start": "^\\s*//\\s*#?region\\b",
            "end": "^\\s*//\\s*#?endregion\\b"
        }
    },
    "onEnterRules": [
        {
            "previousLineText": "^\\s*(?:(?:else\\s+)?(?:[!#%*]*\\s*[A-Za-z_$][\\w$]*\\s*\\((?:\"(?:\\\\.|[^\"\\\\])*\"|[^\"{};])*\\)\\s*)|else\\s*)(?://.*)?$",
            "beforeText": "^\\s+(?:\"(?:\\\\.|[^\"\\\\])*\"|/\\*.*?\\*/|[^\"{};])+;\\s*(?://.*)?$",
            "afterText": "^\\s*$",
            "action": {
                "indent": "outdent"
            }
        },
        {
            "beforeText": "^\\s*/\\*(?!.*\\*/).*$",
            "afterText": "^\\s*\\*/",
            "action": {
                "indent": "indentOutdent",
                "appendText": " * "
            }
        },
        {
            "beforeText": "^\\s*/\\*(?!.*\\*/).*$",
            "action": {
                "indent": "none",
                "appendText": " * "
            }
        },
        {
            "beforeText": "^\\s*\\*(?!/).*$",
            "previousLineText": "^\\s*(?:/\\*|\\*(?!/))",
            "action": {
                "indent": "none",
                "appendText": "* "
            }
        },
        {
            "beforeText": "^\\s*\\*/\\s*$",
            "action": {
                "indent": "none",
                "removeText": 1
            }
        }
    ]
}
