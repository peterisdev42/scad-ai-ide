{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}",
            "notIn": ["string", "comment"]
        },
        {
            "open": "[",
            "close": "]",
            "notIn": ["string", "comment"]
        },
        {
            "open": "(",
            "close": ")",
            "notIn": ["string", "comment"]
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": ["string", "comment"]
        }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "autoCloseBefore": ";:.,=}]) \n\t",
    "wordPattern": "\\$?[a-zA-Z_][a-zA-Z_0-9]*",
    "indentationRules": {
        "increaseIndentPattern": "^((?!//).)*[\\{\\(\\[][^}\\)\\]\"/]*(?://.*)?$",
        "decreaseIndentPattern": "^\\s*[\\}\\)\\]]",
        "unIndentedLinePattern": "^\\s*//.*$"
    },
    "folding": {
        "markers": {
            "start": "^\\s*//\\s*#?region\\b",
            "end": "^\\s*//\\s*#?endregion\\b"
        }
    }
}
