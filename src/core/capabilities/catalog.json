  {
    "id": "customizer.set",
    "toolName": "scad_ai_ide_customizer_set",
    "title": "Set model parameters atomically",
    "description": "Set validated parameter overrides atomically on the exact target/revision from customizer_state. Values must match parameter schema. Updates GUI/Preview; does not edit SCAD source.",
    "risk": "change",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "maxItems": 4,
                "minItems": 1
              }
            ]
          }
        }
      },
      "required": [
        "target",
        "revision",
        "values"
      ]
    },
    "service": "CustomizerDomainService.setValues",
    "gui": "Customizer set"
  },
