[
  {
    "group": "libraries",
    "source": "src/features/libraries/LibraryService.ts",
    "pattern": "'(libraries\\.[A-Za-z]+)'",
    "actions": {
      "libraries.cancel": {
        "capabilities": [
          "operation.cancel"
        ],
        "examples": [
          {
            "capability": "operation.cancel",
            "input": {
              "domain": "libraries"
            }
          }
        ]
      },
      "libraries.refresh": {
        "capabilities": [
          "libraries.refresh"
        ],
        "examples": [
          {
            "capability": "libraries.refresh",
            "input": {}
          }
        ]
      },
      "libraries.selectProject": {
        "uiOnly": "GUI project selection; Agent always supplies explicit project"
      },
      "libraries.search": {
        "capabilities": [
          "libraries.search"
        ],
        "examples": [
          {
            "capability": "libraries.search",
            "input": {
              "query": "BOSL2"
            }
          }
        ]
      },
      "libraries.install": {
        "capabilities": [
          "libraries.install"
        ],
        "examples": [
          {
            "capability": "libraries.install",
            "input": {
              "project": "/workspace",
              "id": "bosl2",
              "version": "v1"
            }
          }
        ]
      },
      "libraries.remove": {
        "capabilities": [
          "libraries.remove"
        ],
        "examples": [
          {
            "capability": "libraries.remove",
            "input": {
              "project": "/workspace",
              "id": "bosl2"
            }
          }
        ]
      },
      "libraries.restore": {
        "capabilities": [
          "libraries.restore"
        ],
        "examples": [
          {
            "capability": "libraries.restore",
            "input": {
              "project": "/workspace"
            }
          }
        ]
      },
      "libraries.repair": {
        "capabilities": [
          "libraries.restore"
        ],
        "examples": [
          {
            "capability": "libraries.restore",
            "input": {
              "project": "/workspace"
            }
          }
        ]
      },
      "libraries.cleanupAll": {
        "capabilities": [
          "libraries.cleanupPlan",
          "libraries.cleanupExecute"
        ],
        "examples": [
          {
            "capability": "libraries.cleanupPlan",
            "input": {
              "mode": "unused"
            }
          },
          {
            "capability": "libraries.cleanupExecute",
            "input": {
              "planId": "cleanup-plan"
            }
          },
          {
            "capability": "libraries.cleanupPlan",
            "input": {
              "mode": "all"
            }
          }
        ]
      },
      "libraries.verifyAll": {
        "capabilities": [
          "libraries.verify"
        ],
        "examples": [
          {
            "capability": "libraries.verify",
            "input": {}
          }
        ]
      },
      "libraries.verify": {
        "capabilities": [
          "libraries.verify"
        ],
        "examples": [
          {
            "capability": "libraries.verify",
            "input": {
              "key": "library-cache-key"
            }
          }
        ]
      },
      "libraries.previewCleanup": {
        "capabilities": [
          "libraries.cleanupPlan",
          "libraries.cleanupExecute"
        ],
        "examples": [
          {
            "capability": "libraries.cleanupPlan",
            "input": {
              "key": "library-cache-key"
            }
          },
          {
            "capability": "libraries.cleanupExecute",
            "input": {
              "planId": "cleanup-plan"
            }
          }
        ]
      },
