{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://scad-ai-ide.invalid/schema/ai-preferences",
    "oneOf": [
        {
            "type": "object",
            "properties": {
                "action": {
                    "const": "ai.setIntegrationEnabled"
                },
                "controlId": {
                    "enum": [
                        "agentEnabled",
                        "guidanceEnabled"
                    ]
                },
                "enabled": {
                    "type": "boolean"
                }
            },
            "required": [
                "action",
                "controlId",
                "enabled"
            ],
            "additionalProperties": false
        },
        {
            "type": "object",
            "properties": {
                "action": {
                    "const": "ai.applyPreferencePreset"
                },
                "preset": {
                    "enum": [
                        "defaults",
                        "off"
                    ]
                }
            },
            "required": [
                "action",
                "preset"
            ],
            "additionalProperties": false
        },
        {
            "type": "object",
            "properties": {
                "action": {
                    "const": "ai.setGroupEnabled"
                },
                "groupId": {
                    "enum": [
                        "cad",
                        "runtime",
                        "customizer",
                        "libraries",
                        "github",
                        "development",
                        "discovery"
                    ]
                },
                "enabled": {
                    "type": "boolean"
                }
            },
            "required": [
                "action",
                "groupId",
                "enabled"
            ],
            "additionalProperties": false
        },
        {
            "type": "object",
            "properties": {
                "action": {
                    "const": "ai.setFeatureEnabled"
                },
                "featureId": {
                    "enum": [
                        "tool.capabilities.discover",
                        "tool.operation.status",
                        "tool.operation.cancel",
                        "tool.runtime.state",
                        "tool.runtime.builds",
                        "tool.runtime.refresh",
                        "tool.runtime.installBuild",
                        "tool.runtime.installArchive",
                        "tool.runtime.addExecutable",
                        "tool.runtime.select",
                        "tool.runtime.remove",
                        "tool.customizer.state",
                        "tool.customizer.set",
                        "tool.customizer.reset",
                        "tool.customizer.applyPreset",
                        "tool.customizer.createPreset",
                        "tool.customizer.savePreset",
                        "tool.customizer.deletePreset",
                        "tool.customizer.importPresets",
                        "tool.customizer.exportPresets",
                        "tool.libraries.search",
                        "tool.libraries.refresh",
                        "tool.libraries.projectState",
                        "tool.libraries.globalState",
                        "tool.libraries.install",
                        "tool.libraries.remove",
                        "tool.libraries.restore",
                        "tool.libraries.verify",
                        "tool.libraries.repair",
                        "tool.libraries.cleanupPlan",
                        "tool.libraries.cleanupExecute",
                        "tool.more.githubStatus",
                        "tool.more.authorizeGitHub",
                        "tool.development.status",
                        "tool.development.listCaches",
                        "tool.development.inspectCache",
                        "tool.development.clearCaches",
                        "tool.customizer.sourceAnalyze",
                        "tool.customizer.sourceApply",
                        "tool.customizer.sourceValidate",
                        "tool.cad.modelAnalyze",
                        "tool.cad.issueDetails",
                        "tool.cad.modelMeasure",
                        "tool.cad.modelRenderViews",
                        "tool.cad.listParts",
                        "tool.cad.checkAssembly",
                        "tool.cad.compare",
                        "tool.cad.getFeedback",
                        "tool.cad.requestPointing",
                        "tool.cad.checkPrintability",
                        "tool.cad.manageReview",
                        "instruction.discovery.openscad",
                        "instruction.customizer.openscad-customizer",
                        "skill.runtime.openscad-runtime",
                        "skill.libraries.openscad-libraries",
                        "skill.customizer.openscad-customizer",
                        "skill.customizer.openscad-customizer-authoring",
                        "skill.development.scad-ai-ide-diagnostics",
                        "skill.cad.openscad-model-debugging",
                        "skill.cad.openscad-geometry-verification",
                        "skill.cad.openscad-assembly-design",
                        "skill.cad.openscad-modeling-lifecycle",
                        "skill.cad.openscad-design-review",
                        "skill.cad.openscad-spatial-feedback",
                        "skill.cad.openscad-printability"
                    ]
                },
                "enabled": {
                    "type": "boolean"
                }
            },
            "required": [
                "action",
                "featureId",
                "enabled"
            ],
            "additionalProperties": false
        },
        {
            "type": "object",
            "properties": {
                "action": {
                    "const": "ai.setSettingEnabled"
                },
                "featureId": {
                    "const": "setting.editor.onSave"
                },
                "value": {
                    "type": "string",
                    "enum": [
                        "off",
                        "diagnostics"
                    ]
                }
            },
            "required": [
                "action",
                "featureId",
                "value"
            ],
            "additionalProperties": false
        },
        {
            "type": "object",
            "properties": {
                "action": {
                    "const": "ai.setSettingEnabled"
                },
                "featureId": {
                    "const": "setting.editor.sourceDiagnostics"
                },
                "value": {
                    "type": "boolean"
                }
            },
            "required": [
                "action",
                "featureId",
                "value"
            ],
            "additionalProperties": false
        }
    ]
}
