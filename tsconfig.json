{
    "include": ["src/**/*.ts", "src/**/*.mts"],
    "exclude": ["src/features/preview/webview", "src/test/preview"],
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node", "mocha"],
        "sourceMap": true,
        // vscode-jsonrpc 8 declares pre-TS 5.6 Map iterators; check our sources against TS 6.
        "skipLibCheck": true,
        "rootDir": "src",
        "strict": true
    }
}
