{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^cad-[a-f0-9-]{36}$"
    },
    "recordRevision": {
      "type": "integer",
      "minimum": 1
    },
    "ownerUri": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "resolved",
        "stale"
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 2048
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reportId": {
          "type": "string",
          "pattern": "^cad-[a-f0-9-]{36}$"
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "partId": {
          "type": [
            "string",
            "null"
          ]
        },
        "objectId": {
          "type": "string"
        },
        "anchorHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "triangle": {
          "type": "integer",
          "minimum": 0
        },
        "mesh": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "localPosition": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "normal": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "localNormal": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "matrix": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "number"
          }
        },
        "units": {
          "enum": [
            "mm",
            "modelUnits"
          ]
        },
        "camera": {},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uri": {
              "type": "string"
            },
            "selector": {},
            "instanceId": {
              "type": "string"
            },
            "sourceTriangle": {
              "type": "integer",
              "minimum": 0
            },
            "confidence": {
              "const": "mesh-only"
            }
          },
          "required": [
            "uri",
            "instanceId",
            "sourceTriangle",
            "confidence"
          ]
        }
      },
      "required": [
        "reportId",
        "snapshotId",
        "revision",
        "partId",
        "objectId",
        "anchorHash",
        "triangle",
        "mesh",
        "position",
        "localPosition",
        "normal",
        "localNormal",
        "matrix",
        "units",
        "camera",
        "source"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "createdAt": {
      "type": "number"
    },
    "updatedAt": {
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "recordRevision",
    "ownerUri",
    "status",
    "text",
    "anchor",
    "history",
    "createdAt",
    "updatedAt"
  ]
}
