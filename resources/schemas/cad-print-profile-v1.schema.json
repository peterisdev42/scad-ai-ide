{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "units",
    "process",
    "buildVolumeMm",
    "buildPose",
    "maxOverhangFromVerticalDeg"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "units": {
      "const": "mm"
    },
    "process": {
      "const": "fdm"
    },
    "buildVolumeMm": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "buildPose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rotate",
        "translate"
      ],
      "properties": {
        "rotate": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "translate": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "maxOverhangFromVerticalDeg": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 90
    }
  }
}
