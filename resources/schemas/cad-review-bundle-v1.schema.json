{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "report": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "enum": [
            2,
            3
          ]
        },
        "reportId": {
          "type": "string",
          "pattern": "^cad-[a-f0-9-]{36}$"
        }
      },
      "required": [
        "schemaVersion",
        "reportId"
      ]
    },
    "retainedArtifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "savedAt": {
      "type": "number"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "report",
    "retainedArtifacts",
    "savedAt"
  ]
}
