{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reportId": {
      "type": "string",
      "pattern": "^cad-[a-f0-9-]{36}$"
    },
    "ownerUri": {
      "type": "string"
    },
    "createdAt": {
      "type": "number"
    },
    "kind": {
      "const": "print-assessment"
    },
    "sourceReportId": {
      "type": "string",
      "pattern": "^cad-[a-f0-9-]{36}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileUri": {
      "type": "string"
    },
    "profileDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "type": "object"
    },
    "partId": {
      "type": [
        "string",
        "null"
      ]
    },
    "units": {
      "const": "mm"
    },
    "assessmentStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ]
    },
    "printability": {
      "const": "NOT_CHECKED"
    },
    "result": {
      "type": "object"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notChecked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "reportId",
    "ownerUri",
    "createdAt",
    "kind",
    "sourceReportId",
    "snapshotId",
    "profileUri",
    "profileDigest",
    "profileContentHash",
    "profile",
    "partId",
    "units",
    "assessmentStatus",
    "printability",
    "result",
    "issues",
    "notChecked"
  ]
}
