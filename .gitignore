# Node dependencies and local package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Extension bundles, compiled tests, native builds and staged licenses
/dist/
/out/
/.build/
/server/
/licenses/
*.tsbuildinfo
*.vsix
*.tgz

# Test installations, coverage and tool caches
/.vscode-test/
coverage/
.nyc_output/
*.lcov
.cache/
.eslintcache
.prettiercache

# Logs, diagnostics and local environment
logs/
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.pid
*.pid.lock
.node_repl_history
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Preview sync baselines are versioned; only review/temporary files are ignored
/.preview-sync/plans/
/.preview-sync/merge-*/
/.preview-sync/lock
*.preview-sync-*

# Browser automation session artifacts
/.playwright-cli/
