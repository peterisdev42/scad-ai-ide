{
    "name": "scad-ai-ide",
    "displayName": "SCAD AI IDE",
    "description": "OpenSCAD runtime discovery and development tools for VS Code",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.140.0"
    },
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onLanguage:openscad"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "markdown.markdownItPlugins": true,
        "markdown.previewStyles": [
            "./media/markdown/preview.css"
        ],
        "markdown.previewScripts": [
            "./media/markdown/preview.js",
            "./dist/markdown-preview.js"
        ],
        "commands": [
            {
                "command": "scad-ai-ide.connectGitHub",
                "title": "Connect GitHub Account",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.selectRuntime",
                "title": "Select OpenSCAD Runtime",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.refreshRuntimes",
                "title": "Discover OpenSCAD Runtimes",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.addRuntime",
                "title": "Add OpenSCAD Runtime",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.installRuntimeArchive",
                "title": "Install OpenSCAD Runtime from Archive",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai.ai.open",
                "title": "Open AI",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai.bricks.open",
                "title": "Open Bricks",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai.libraries.open",
                "title": "Open Libraries",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai.more.open",
                "title": "Open More",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai.runtime.open",
                "title": "Open Runtime",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.restartLanguageServer",
                "title": "Restart OpenSCAD Language Server",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.showLanguageServerOutput",
                "title": "Show OpenSCAD Language Server Output",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.showPreview",
                "title": "Open as Preview",
                "icon": "$(preview)",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.showSource",
                "title": "Reopen as source file",
                "icon": "$(file-code)",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.togglePreview",
                "title": "Toggle Preview",
                "category": "SCAD AI IDE"
            },
            {
                "command": "scad-ai-ide.customizer.resetAll",
                "title": "Reset all parameters",
                "category": "SCAD AI IDE",
                "icon": "$(refresh)",
                "enablement": "scad-ai-ide.customizer.hasParameters"
            },
            {
                "command": "scad-ai-ide.customizer.collapseAll",
                "title": "Collapse All",
                "category": "SCAD AI IDE",
                "icon": "$(collapse-all)",
                "enablement": "scad-ai-ide.customizer.hasGroups"
            },
            {
                "command": "scad-ai-ide.customizer.expandAll",
                "title": "Expand All",
                "category": "SCAD AI IDE",
                "icon": "$(expand-all)",
                "enablement": "scad-ai-ide.customizer.hasGroups"
            },
            {
                "command": "scad-ai-ide.markdown.openPreview",
                "title": "Open Markdown Preview with 3D Tools",
                "category": "SCAD AI IDE",
                "icon": "$(open-preview)"
            }
        ],
        "configuration": {
            "title": "SCAD AI IDE",
            "properties": {
                "scad-ai-ide.openscadPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "Absolute path to the OpenSCAD executable, or a macOS `.app`. Leave empty for automatic discovery (PATH, then common installation locations). Runs on the extension host, including SSH, WSL, or containers."
                },
                "scad-ai-ide.runtimeCommand": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "default": null,
                    "scope": "machine",
                    "additionalProperties": false,
                    "required": [
                        "executable",
                        "argsPrefix"
                    ],
                    "properties": {
                        "executable": {
                            "type": "string",
                            "minLength": 1
                        },
                        "argsPrefix": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "markdownDescription": "Selected runtime launch command, including Flatpak/Snap arguments. Use **SCAD AI IDE: Select OpenSCAD Runtime** to change it. `openscadPath` takes precedence when nonempty."
                },
                "scad-ai-ide.languageServer.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable openscad-LSP in trusted workspaces."
                },
                "scad-ai-ide.languageServer.path": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "description": "Absolute path to openscad-lsp on the extension host. Empty uses the bundled binary, then openscad-lsp on PATH."
                },
                "scad-ai-ide.languageServer.searchPaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Absolute OpenSCAD library directories. Changing this setting restarts the server to remove stale paths."
                },
                "scad-ai-ide.languageServer.defaultParameters": {
                    "type": "boolean",
                    "default": true,
                    "description": "Include optional default parameters in LSP completion snippets."
                },
                "scad-ai-ide.languageServer.indent": {
                    "type": "string",
                    "default": "    ",
                    "pattern": "^\\s+$",
                    "description": "Whitespace used by the OpenSCAD formatter."
                },
                "scad-ai-ide.languageServer.queryFile": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "description": "Absolute path to a custom Topiary formatting query. Empty uses the server default."
                },
                "scad-ai-ide.preview.format": {
                    "type": "string",
                    "enum": [
                        "3mf",
                        "stl"
                    ],
                    "default": "stl",
                    "description": "The format to use for the 3D preview. 3MF supports colors but requires OpenSCAD Nightly. STL is universally supported."
                },
                "scad-ai-ide.preview.renderMode": {
                    "type": "string",
                    "enum": [
                        "preview",
                        "render"
                    ],
                    "enumDescriptions": [
                        "Raster CSG boolean preview. The host prepares operands and local geometry; unsupported nodes report an error and retain the last valid frame.",
                        "Fully evaluated interactive 3D model using the selected STL/3MF format."
                    ],
                    "default": "render",
                    "description": "Initial preview mode for SCAD files. Switch between CSG preview and full mesh render in the top toolbar; mesh exports always evaluate the full geometry."
                },
                "scad-ai-ide.preview.slicerExecutable": {
                    "type": "string",
                    "default": "",
                    "description": "Optional path to the slicer executable (e.g., Bambu Studio or PrusaSlicer). If left empty, the OS default application for the 3D model will be used.",
                    "scope": "machine"
                },
                "scad-ai-ide.preview.enableLazyUnion": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable lazy unions, creating a multi-part exported object."
                },
                "scad-ai-ide.markdown.preview.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show Preview and Source tabs for OpenSCAD fenced blocks in built-in and extension-managed Markdown previews. Requires workspace trust and an available OpenSCAD runtime."
                },
                "scad-ai-ide.markdown.preview.renderMode": {
                    "type": "string",
                    "enum": [
                        "preview",
                        "render"
                    ],
                    "enumDescriptions": [
                        "Interactive CSG tree preview, with $preview set to true.",
                        "Interactive native mesh render. Evaluates the final geometry, with $preview set to false."
                    ],
                    "default": "render",
                    "description": "OpenSCAD CLI mode used to generate interactive Markdown previews. Changing the mode refreshes cached previews."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "scad-ai-ide",
                    "title": "SCAD AI IDE",
                    "icon": "resources/scad.svg"
                }
            ]
        },
        "views": {
            "scad-ai-ide": [
                {
                    "id": "scad-ai.quickAccess",
                    "name": "Quick Access"
                },
                {
                    "type": "webview",
                    "id": "scad-ai.customizer",
                    "name": "Customizer"
                }
            ]
        },
        "menus": {
            "commandPalette": [
                {
                    "command": "scad-ai-ide.showPreview",
                    "when": "resourceScheme == file && resourceFilename =~ /\\.(scad|csg|stl|3mf)$/i && activeCustomEditorId != 'scad-ai-ide.preview.editor' && activeCustomEditorId != 'scad-ai-ide.preview.mesh'"
                },
                {
                    "command": "scad-ai-ide.showSource",
                    "when": "(activeCustomEditorId == 'scad-ai-ide.preview.editor' || activeCustomEditorId == 'scad-ai-ide.preview.mesh')"
                },
                {
                    "command": "scad-ai-ide.togglePreview",
                    "when": "(resourceScheme == file && resourceFilename =~ /\\.(scad|csg|stl|3mf)$/i) || (activeCustomEditorId == 'scad-ai-ide.preview.editor' || activeCustomEditorId == 'scad-ai-ide.preview.mesh')"
                },
                {
                    "command": "scad-ai-ide.customizer.resetAll",
                    "when": "false"
                },
                {
                    "command": "scad-ai-ide.customizer.collapseAll",
                    "when": "false"
                },
                {
                    "command": "scad-ai-ide.customizer.expandAll",
                    "when": "false"
                },
                {
                    "command": "scad-ai-ide.markdown.openPreview",
                    "when": "editorLangId == markdown"
                }
            ],
            "editor/title": [
                {
                    "command": "scad-ai-ide.showPreview",
                    "group": "navigation@2",
                    "when": "resourceScheme == file && resourceFilename =~ /\\.(scad|csg|stl|3mf)$/i && activeCustomEditorId != 'scad-ai-ide.preview.editor' && activeCustomEditorId != 'scad-ai-ide.preview.mesh'"
                },
                {
                    "command": "scad-ai-ide.showSource",
                    "group": "navigation@2",
                    "when": "(activeCustomEditorId == 'scad-ai-ide.preview.editor' || activeCustomEditorId == 'scad-ai-ide.preview.mesh')"
                },
                {
                    "command": "scad-ai-ide.markdown.openPreview",
                    "group": "navigation@3",
                    "when": "resourceLangId == markdown"
                }
            ],
            "view/title": [
                {
                    "command": "scad-ai-ide.customizer.resetAll",
                    "when": "view == scad-ai.customizer && scad-ai-ide.customizer.hasParameters",
                    "group": "navigation@1"
                },
                {
                    "command": "scad-ai-ide.customizer.collapseAll",
                    "when": "view == scad-ai.customizer && scad-ai-ide.customizer.hasGroups && !scad-ai-ide.customizer.allCollapsed",
                    "group": "navigation@2"
                },
                {
                    "command": "scad-ai-ide.customizer.expandAll",
                    "when": "view == scad-ai.customizer && scad-ai-ide.customizer.hasGroups && scad-ai-ide.customizer.allCollapsed",
                    "group": "navigation@2"
                }
            ]
        },
        "languages": [
            {
                "id": "openscad",
                "aliases": [
                    "OpenSCAD",
                    "scad"
                ],
                "extensions": [
                    ".scad",
                    ".csg"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./resources/openscad.svg",
                    "dark": "./resources/openscad.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "openscad",
                "scopeName": "source.openscad",
                "path": "./syntaxes/openscad.tmLanguage.json"
            },
            {
                "scopeName": "markdown.openscad.codeblock",
                "path": "./syntaxes/markdown-openscad.tmLanguage.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.openscad": "openscad"
                }
            }
        ],
        "snippets": [
            {
                "language": "openscad",
                "path": "./snippets/openscad.json"
            }
        ],
        "configurationDefaults": {
            "[openscad]": {
                "editor.insertSpaces": true,
                "editor.tabSize": 4
            }
        },
        "keybindings": [
            {
                "command": "scad-ai-ide.togglePreview",
                "key": "ctrl+shift+v",
                "mac": "cmd+shift+v",
                "when": "(resourceScheme == file && resourceFilename =~ /\\.(scad|csg|stl|3mf)$/i) || (activeCustomEditorId == 'scad-ai-ide.preview.editor' || activeCustomEditorId == 'scad-ai-ide.preview.mesh')"
            }
        ],
        "customEditors": [
            {
                "viewType": "scad-ai-ide.preview.editor",
                "displayName": "OpenSCAD Preview",
                "selector": [
                    {
                        "filenamePattern": "*.[sS][cC][aA][dD]"
                    },
                    {
                        "filenamePattern": "*.[cC][sS][gG]"
                    }
                ],
                "priority": "option"
            },
            {
                "viewType": "scad-ai-ide.preview.mesh",
                "displayName": "3D Model Preview",
                "selector": [
                    {
                        "filenamePattern": "*.[sS][tT][lL]"
                    },
                    {
                        "filenamePattern": "*.3[mM][fF]"
                    }
                ],
                "priority": "option"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run build:lsp && npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run prepare:licenses",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "check-types": "tsc --noEmit && tsc -p tsconfig.webview.json",
        "lint": "eslint src",
        "test": "npm run compile-tests && node --test out/test/notifications.test.js out/test/runtime.test.js out/test/github.test.js out/test/installation.test.js out/test/customizer.test.js out/test/language.test.js out/test/markdown.test.js && npm run test:preview",
        "test:customizer": "npm run compile-tests && node esbuild.js && node --test scripts/customizer-scrollbar.test.mjs",
        "test:markdown": "npm run compile && npm run compile-tests && node --test out/test/markdown.test.js && node --test scripts/markdown-preview.test.mjs",
        "test:markdown-host": "npm run compile && node --test scripts/markdown-webview.test.mjs",
        "test:fast-preview": "npm run compile && node --import tsx --test src/test/preview/fastPreview.test.ts src/test/preview/csg.test.ts && node --test scripts/preview-fast.test.mjs",
        "test:integration": "npm run compile-tests && npm run compile && vscode-test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build:lsp": "node scripts/build-lsp.cjs",
        "prepare:lsp": "node scripts/prepare-lsp.cjs",
        "prepare:licenses": "node scripts/prepare-licenses.cjs",
        "test:csg-coverage": "node scripts/csg-coverage.mjs --check",
        "build:csg-kernel": "node scripts/build-csg-kernel.mjs",
        "test:csg-gpu": "node --test scripts/csg-gpu.test.mjs",
        "test:csg-native": "node esbuild.js && node --test scripts/csg-native.test.mjs",
        "test:preview": "node --import tsx --test src/test/preview/*.test.ts",
        "test:preview-editor": "npm run package && node scripts/test-preview-editor.mjs",
        "preview:sync": "node scripts/preview-sync.mjs",
        "test:preview-sync": "node --test scripts/preview-sync/engine.test.mjs",
        "build:csg": "node scripts/build-csg-core.mjs",
        "test:csg-package": "node scripts/verify-csg-package.mjs"
    },
    "devDependencies": {
        "@types/markdown-it": "^14.2.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/pngjs": "6.0.5",
        "@types/three": "0.186.0",
        "@types/vscode": "^1.140.0",
        "@types/vscode-webview": "^1.57.5",
        "@types/yauzl": "^3.4.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "markdown-it": "^14.3.3",
        "monaco-editor": "0.57.0",
        "npm-run-all": "^4.1.5",
        "playwright": "1.61.1",
        "prettier": "^3.9.10",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Runtime discovery and execution require workspace trust."
        },
        "virtualWorkspaces": false
    },
    "dependencies": {
        "@lit/context": "^1.1.6",
        "@vscode-elements/elements": "^2.5.1",
        "@vscode/codicons": "^0.0.45",
        "@zkl2333/freetype-wasm": "2.14.3",
        "dxf-parser": "1.1.2",
        "fflate": "0.8.3",
        "harfbuzzjs": "1.6.4",
        "jsonc-parser": "^3.3.1",
        "linkedom": "0.18.12",
        "lit": "^3.3.2",
        "manifold-3d": "^3.5.4",
        "pngjs": "7.0.0",
        "straight-skeleton": "3.0.0",
        "tar": "^7.5.22",
        "three": "0.187.0",
        "vscode-languageclient": "^9.0.1",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2",
        "yaml": "^2.9.1",
        "yauzl": "^3.4.0"
    }
}
