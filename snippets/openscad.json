{
    "Module": {
        "prefix": "module",
        "body": ["module ${1:name}(${2:parameters}) {", "\t$0", "}"],
        "description": "Define an OpenSCAD module"
    },
    "Function": {
        "prefix": "function",
        "body": "function ${1:name}(${2:parameters}) = ${0:expression};",
        "description": "Define an OpenSCAD function"
    },
    "For": {
        "prefix": "for",
        "body": ["for (${1:i} = [${2:0}:${3:10}]) {", "\t$0", "}"],
        "description": "Iterate over a range"
    },
    "If": {
        "prefix": "if",
        "body": ["if (${1:condition}) {", "\t$0", "}"],
        "description": "Conditional geometry"
    },
    "Difference": {
        "prefix": "difference",
        "body": ["difference() {", "\t${1:cube(10);}", "\t$0", "}"],
        "description": "Subtract child geometry"
    },
    "Include": {
        "prefix": "include",
        "body": "include <${1:library.scad}>",
        "description": "Include a library"
    },
    "Use": {
        "prefix": "use",
        "body": "use <${1:library.scad}>",
        "description": "Import library modules and functions"
    },
    "Region": {
        "prefix": "region",
        "body": ["// #region ${1:name}", "$0", "// #endregion"],
        "description": "Foldable region"
    }
}
